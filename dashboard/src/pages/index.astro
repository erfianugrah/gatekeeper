---
// Splash page - shown briefly before redirecting to /dashboard/
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gatekeeper</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      @import "@fontsource/ibm-plex-mono/400.css";
      @import "@fontsource/ibm-plex-mono/600.css";
      @import "@fontsource/ibm-plex-mono/700.css";

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background-color: #14110d;
        color: #e8e0ce;
        font-family: "IBM Plex Mono", "JetBrains Mono", "Menlo", "Consolas", monospace;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }

      .splash {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        border: 1px solid #3a342a;
        padding: 3rem 4rem;
      }

      /* Shield icon */
      .shield {
        width: 56px;
        height: 56px;
      }
      .shield path { stroke: #b08fc4; }
      .shield circle, .shield rect { fill: #b08fc4; }

      /* Title */
      .title {
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #e8e0ce;
      }

      /* Progress bar -- functional timer for the redirect, not decoration */
      .progress-track {
        width: 160px;
        height: 2px;
        background: #3a342a;
        overflow: hidden;
      }
      .progress-fill {
        height: 100%;
        width: 0%;
        background: #b08fc4;
        animation: fill 1.2s linear 0.3s forwards;
      }

      /* Subtitle / link */
      .subtitle {
        font-size: 0.75rem;
        color: #8c8474;
      }
      .subtitle a {
        color: #e8e0ce;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      @keyframes fill {
        to { width: 100%; }
      }

      @media (prefers-reduced-motion: reduce) {
        .progress-fill { animation: none; width: 100%; }
      }
    </style>
  </head>
  <body>
    <div class="splash">
      <!-- Shield logo (matches sidebar) -->
      <svg class="shield" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linejoin="round">
        <path d="M12 2 L3 6.5 L3 12 C3 18.5 6.8 23 12 24.5 C17.2 23 21 18.5 21 12 L21 6.5 Z" />
        <circle cx="12" cy="11" r="2.5" />
        <rect x="11" y="13" width="2" height="4" rx="0.8" />
      </svg>

      <div class="title">Gatekeeper</div>

      <div class="progress-track">
        <div class="progress-fill"></div>
      </div>

      <div class="subtitle" id="quip"></div>

      <noscript>
        <div class="subtitle">
          <a href="/dashboard/">Continue to dashboard</a>
        </div>
      </noscript>
    </div>

    <script is:inline>
      var quips = [
        'You shall not pass... without valid credentials.',         // LotR - used in auth guards everywhere
        'sudo make me a sandwich.',                                 // xkcd #149
        'correct horse battery staple.',                            // xkcd #936
        'All your base are belong to us.',                          // Zero Wing
        "There's no place like 127.0.0.1.",                         // Classic sysadmin
        'Follow the white rabbit.',                                 // The Matrix
        "I'm in.",                                                  // Every hacker movie ever
        'Trust, but verify.',                                       // Zero Trust doctrine
        'It works on my machine.',                                  // Universal dev truth
        'Have you tried turning it off and on again?',              // IT Crowd
        'Authorization: Bearer of good news.',                      // HTTP header pun
        'There are only 10 types of people in the world.',          // Binary joke
        "The cloud is just someone else's computer.",               // Infosec proverb
        '// TODO: fix this later.',                                 // Found in every codebase
        'rm -rf / for free WiFi.',                                  // Hak5 SSID payloads
        'SELECT * FROM users WHERE clue > 0; -- 0 rows returned.', // SQL humor
        'Roses are #FF0000, violets are #0000FF.',                  // Programmer poetry
        'Works as designed. Not as expected.',                       // QA proverb
        'The S in IoT stands for Security.',                        // Infosec truism
        "HTTP 418: I'm a teapot.",                                  // RFC 2324
        "It's not DNS. There's no way it's DNS. It was DNS.",       // Every sysadmin ever
      ];
      document.getElementById('quip').textContent = quips[Math.floor(Math.random() * quips.length)];
      setTimeout(function () { window.location.href = '/dashboard/'; }, 1700);
    </script>
  </body>
</html>
